# Rendered daily; regenerated on every run.
backgrounds/today.jpg

# Fetched artwork lives in XDG cache, but guard against a stray local dir.
cache/
__pycache__/
*.pyc

# Generated alongside colors.toml; absence just means the lock screen
# rolls its own Pokemon.
shell.lock.toml

# Generated alongside colors.toml; inert without the ambient plugin.
shell.background.toml

# Generated by install.sh from manifest.json.in with the local username.
plugins/background/manifest.json

Speed up omarchy menu dmenu-mode search (pokemon picker: 905 rows).
Parse options once per summon; per keystroke, match cached lowercase haystacks,
and when the query merely extends the previous one, scan only the previous
matches. Local patch against omarchy 4.0.0-1; pacman overwrites Menu.qml on
update -- reapply with:
  sudo cp /usr/share/omarchy/shell/plugins/menu/Menu.qml{,.orig}
  sudo patch /usr/share/omarchy/shell/plugins/menu/Menu.qml < docs/omarchy-menu-dmenu-search.patch
  omarchy-restart-shell
Worth offering upstream.

--- /usr/share/omarchy/shell/plugins/menu/Menu.qml	2026-08-14 17:24:18.000000000 +0200
+++ /tmp/claude-1000/-home-wseubring-Development-personal-omarchy-pokemon-theme/0978bdb4-a879-41b9-9b2b-bdd0af4e5a23/scratchpad/Menu.qml	2026-08-18 21:10:09.677528784 +0200
@@ -56,6 +56,27 @@
   readonly property bool dmenuActive: mode === "select" || mode === "input"
   property string dmenuPrompt: ""
   property var dmenuOptions: []
+  // Options parsed once per summon instead of on every keystroke: with large
+  // lists (hundreds of rows) re-splitting and lowercasing each option per
+  // filter edit is the bulk of the search latency.
+  property var dmenuParsed: []
+  property string dmenuLastQuery: ""
+  property var dmenuLastMatches: []
+  onDmenuOptionsChanged: {
+    var parsed = []
+    for (var i = 0; i < dmenuOptions.length; i++) {
+      var parts = String(dmenuOptions[i] || "").split("\t")
+      var icon = parts.length > 1 ? parts.shift() : ""
+      var label = parts.shift() || ""
+      var detail = parts.join("\t")
+      // "\n" separates label and detail so a query can never straddle them.
+      parsed.push({ icon: icon, label: label, detail: detail, index: i,
+                    haystack: (label + "\n" + detail).toLowerCase() })
+    }
+    dmenuParsed = parsed
+    dmenuLastQuery = ""
+    dmenuLastMatches = []
+  }
   property string selectionFile: ""
   property string doneFile: ""
   property int dmenuWidth: 300

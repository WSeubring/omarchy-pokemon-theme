[Unit]
Description=Generate the Pokemon-of-the-day Omarchy theme
Documentation=https://github.com/WSeubring/omarchy-pokemon-theme
# The generator asks omarchy to re-apply the theme, which talks to the running
# shell over IPC. Nothing breaks without it -- the files are still written and
# every config regenerated -- but the retint waits for the next apply.
After=graphical-session.target

[Service]
Type=oneshot
# The artwork is fetched over the network and the timer catches up the moment a
# laptop wakes, which is before DNS answers -- and a fetch that fails there
# leaves the day's wallpaper as bare ground with no Pokemon on it. There is no
# network-online.target in the user manager to wait on, so wait on
# NetworkManager instead; the leading "-" keeps the run going where nm-online
# is missing or the wait times out, and the generator retries on its own.
ExecStartPre=-/usr/bin/nm-online -q -t 60
ExecStart=%h/.config/omarchy/themes/pokemon/bin/pokemon-theme-gen
# The connectivity wait, a retried artwork download and the wallpaper render,
# end to end and worst case.
TimeoutStartSec=360

#!/usr/bin/env python3
"""Generate the Pokemon-of-the-day Omarchy theme.

Writes colors.toml and a single wallpaper into the theme directory, then asks
Omarchy to re-apply the theme so every downstream app retints.
"""

import argparse
import json
import os
import random
import shutil
import subprocess
import sys
from datetime import date, datetime

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

import ambient  # noqa: E402
import artwork  # noqa: E402
import atomic  # noqa: E402
import config  # noqa: E402
import lockscreen  # noqa: E402
import palette  # noqa: E402
import pins  # noqa: E402
import shiny  # noqa: E402
import state  # noqa: E402
import vesktop  # noqa: E402
import wallpaper  # noqa: E402
import xdg  # noqa: E402
from oklch import hex_to_oklch  # noqa: E402

SLUG = "pokemon"
# Composited wallpapers, keyed by what they are made of. Rendering one takes a
# couple of seconds at desktop resolution, which is long enough to see: the menu
# closes, the previous Pokemon is still on screen, and only then does the theme
# change. Second and later visits to a Pokemon are a rename instead.
WALLPAPERS = xdg.cache("wallpapers")
# 905 Pokemon times however many resolutions have been asked for would grow
# without limit, at ~170KB each. Keeping the most recent few months of them is
# plenty to make revisits instant.
WALLPAPER_CACHE_SIZE = 120

# One file only: omarchy's background chooser cycles the sorted list, so a
# single entry is the only way to guarantee today's wallpaper is the one picked.
# The file is named after what it shows rather than a constant "today.jpg": the
# shell's background layer caches by path, so a fixed name with changing content
# leaves stale pixels behind and flashes the previous Pokemon on the next swap.
BACKGROUNDS = os.path.join(ROOT, "backgrounds")


def variant_slug(is_shiny, mode, intensity):
    """The palette-affecting knobs, as a filename fragment.

    The wallpaper is a pure function of artwork + palette, so everything that
    changes the palette has to be in the cache key or a mode flip would serve
    yesterday's colours from cache.
    """
    parts = []
    if is_shiny:
        parts.append("-shiny")
    if mode == "light":
        parts.append("-light")
    if intensity != 1.0:
        parts.append("-i%s" % ("%.2f" % intensity).rstrip("0").rstrip("."))
    return "".join(parts)


def background_path(dex_id, variant, width, height):
    """The theme's single wallpaper file for this Pokemon at this size."""
    return os.path.join(BACKGROUNDS, "%d%s-%dx%d.jpg"
                        % (dex_id, variant, width, height))


def resolve_mode(now=None, accent_source=None, configured=None):
    """The mode to generate in: the config's word, with "auto" told the time
    and "pokemon" told the day's accent. `configured` overrides the config
    (that is --mode).

    Auto flips to light at light-from and back to dark at dark-from. An
    inverted pair (dark-from before light-from) means the light window wraps
    midnight, which is what the arithmetic below already gives.

    Pokemon mode goes light when the accent -- the creature's dominant artwork
    colour, its type colour as the fallback -- is bright. No accent at all
    stays dark.
    """
    configured = configured or config.mode()
    if configured == "pokemon":
        return palette.mode_for(accent_source)
    if configured != "auto":
        return configured
    now = now or datetime.now()
    minutes = now.hour * 60 + now.minute
    light_from = config.flip_time("light-from", "08:00")
    dark_from = config.flip_time("dark-from", "20:00")
    start = light_from[0] * 60 + light_from[1]
    end = dark_from[0] * 60 + dark_from[1]
    if start <= end:
        return "light" if start <= minutes < end else "dark"
    return "light" if minutes >= start or minutes < end else "dark"


# Yaru ships a fixed set of accent hues; pick whichever sits closest to the
# day's hue so the icon theme moves with the palette instead of staying put.
YARU_HUES = {
    "Yaru-red": 25.0,
    "Yaru-wartybrown": 50.0,
    "Yaru-yellow": 85.0,
    "Yaru-olive": 112.0,
    "Yaru-sage": 145.0,
    "Yaru-prussiangreen": 195.0,
    "Yaru-blue": 258.0,
    "Yaru-purple": 300.0,
    "Yaru-magenta": 340.0,
}


def icon_theme(accent):
    hue = hex_to_oklch(accent)[2]
    return min(YARU_HUES,
               key=lambda name: abs(((YARU_HUES[name] - hue + 180) % 360) - 180))


def load(name):
    with open(os.path.join(ROOT, "data", name)) as fh:
        return json.load(fh)


def wallpaper_for(dex_id, is_shiny, colors, width, height, mode="dark",
                  variant=""):
    """Put the wallpaper for this Pokemon in place, rendering it only if new.

    The composition is a pure function of the artwork and the palette, and both
    follow from the Pokemon, so the file for a given Pokemon and size never needs
    building twice. Hardlinked into the theme rather than copied: `omarchy-theme-set`
    copies the theme into a staging directory anyway, so nothing downstream shares
    the inode.
    """
    cached = os.path.join(WALLPAPERS, "%d%s-%dx%d.jpg"
                          % (dex_id, variant, width, height))
    if os.path.exists(cached) and os.path.getsize(cached) > 0:
        os.utime(cached, None)
    else:
        os.makedirs(WALLPAPERS, exist_ok=True)
        wallpaper.render(artwork.fetch(dex_id, is_shiny), colors, cached,
                         width, height,
                         sparkle="%d-shiny" % dex_id if is_shiny else None,
                         mode=mode)

    _prune(WALLPAPERS, WALLPAPER_CACHE_SIZE)

    background = background_path(dex_id, variant, width, height)
    link = atomic.scratch(background)
    os.makedirs(BACKGROUNDS, exist_ok=True)
    if os.path.exists(link):
        os.remove(link)
    try:
        os.link(cached, link)
    except OSError:
        # Different filesystems, or a filesystem without hardlinks.
        shutil.copyfile(cached, link)
    atomic.commit(link, background)

    # Back to one file: the new wallpaper lands first, then the old ones go, so
    # the chooser never sees an empty directory or cycles between two days.
    for name in os.listdir(BACKGROUNDS):
        stale = os.path.join(BACKGROUNDS, name)
        if stale != background and os.path.isfile(stale):
            os.remove(stale)
    return background


def _prune(directory, keep):
    """Drop all but the `keep` most recently used files in `directory`."""
    try:
        entries = [os.path.join(directory, name) for name in os.listdir(directory)]
    except OSError:
        return
    files = [path for path in entries if os.path.isfile(path)]
    if len(files) <= keep:
        return
    files.sort(key=os.path.getmtime, reverse=True)
    for path in files[keep:]:
        try:
            os.remove(path)
        except OSError:
            pass


def screen_size(fallback=(2560, 1600)):
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], check=True,
                             capture_output=True, text=True).stdout
        mons = json.loads(out)
    except (OSError, subprocess.CalledProcessError, ValueError):
        return fallback
    if not mons:
        return fallback
    # Render for the largest attached monitor; PreserveAspectCrop handles the
    # rest, and upscaling a small render onto a big screen would show.
    best = max(mons, key=lambda m: m.get("width", 0) * m.get("height", 0))
    return int(best["width"]), int(best["height"])


def apply_theme():
    """Re-apply the theme so omarchy regenerates every dependent config.

    OMARCHY_POKEMON_APPLYING lets the theme-set hook see that this run is our
    own and bail out, instead of recursing.
    """
    env = dict(os.environ, OMARCHY_POKEMON_APPLYING="1")
    try:
        subprocess.run(["omarchy-theme-set", SLUG], check=True, env=env,
                       capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        print("omarchy-theme-set not on PATH; files written but not applied",
              file=sys.stderr)
        return False
    except subprocess.CalledProcessError as exc:
        print("omarchy-theme-set failed: %s" % (exc.stderr or "").strip(),
              file=sys.stderr)
        return False
    except subprocess.TimeoutExpired:
        print("omarchy-theme-set timed out", file=sys.stderr)
        return False
    return True


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--date", default=date.today().isoformat(),
                    help="YYYY-MM-DD to generate for (default: today)")
    ap.add_argument("--pokemon", metavar="NAME",
                    help="use this Pokemon for today; reverts at midnight")
    ap.add_argument("--random", action="store_true",
                    help="use a random Pokemon for today, with its own shiny "
                         "roll at 1 in %d; reverts at midnight" % shiny.odds())
    ap.add_argument("--shiny", action="store_true",
                    help="force today's Pokemon shiny, whatever the odds said")
    ap.add_argument("--no-shiny", action="store_true",
                    help="force today's Pokemon normal")
    ap.add_argument("--type-hue", action="store_true",
                    help="take the accent from the type colour, not the artwork")
    ap.add_argument("--pin", metavar="NAME",
                    help="pin this Pokemon permanently, in the user config")
    ap.add_argument("--unpin", action="store_true",
                    help="drop both pins and go back to the daily roll")
    ap.add_argument("--no-apply", action="store_true",
                    help="write the files but do not re-apply the theme")
    ap.add_argument("--no-wallpaper", action="store_true",
                    help="only regenerate colors.toml")
    ap.add_argument("--size", help="wallpaper size as WxH")
    ap.add_argument("--no-animation", action="store_true",
                    help="write the background section with motion switched off")
    ap.add_argument("--no-lock-sync", action="store_true",
                    help="leave the lock screen to roll its own Pokemon")
    ap.add_argument("--mode", choices=("dark", "light", "auto", "pokemon"),
                    help="colour scheme for this run, overriding the config; "
                         "the config's own mode (default dark) rules otherwise")
    ap.add_argument("--force", action="store_true",
                    help="regenerate even if today's theme is already written")
    args = ap.parse_args()

    dex, types = load("dex.json"), load("types.json")
    type_colors = load("type-colors.json")

    if args.pin and args.unpin:
        sys.exit("--pin and --unpin are mutually exclusive")
    if args.random and args.pokemon:
        sys.exit("--random and --pokemon are mutually exclusive")
    if args.shiny and args.no_shiny:
        sys.exit("--shiny and --no-shiny are mutually exclusive")

    if args.pin:
        pinned = args.pin.lower()
        if pinned not in types:
            sys.exit("unknown pokemon: %s" % pinned)
        config.set_key("pokemon", pinned)
        # A today-only pin would otherwise keep winning over the new permanent
        # one for the rest of the day, which is not what "pin this" means.
        pins.clear_today()
        print("pinned %s in %s" % (pinned, config.PATH))
        args.force = True

    if args.unpin:
        removed = config.clear_key("pokemon")
        removed = pins.clear_today() or removed
        print("unpinned" if removed else "nothing was pinned")
        args.force = True

    force_shiny = True if args.shiny else (False if args.no_shiny else None)

    requested = args.pokemon
    if args.random:
        # Excluding what is already showing matters more here than for the daily
        # roll: someone choosing "random" is asking to see something change, and
        # a 1-in-905 no-op reads as a broken button.
        requested = random.choice([n for n in dex if n != state.name()])

    try:
        choice = pins.resolve(args.date, dex, types, requested, force_shiny)
    except ValueError as exc:
        sys.exit(str(exc))
    dex_id, name, kinds, source = (choice.dex_id, choice.name, choice.types,
                                   choice.source)

    if requested or force_shiny is not None:
        # Remembered for the rest of the day, so the timer, the boot catch-up and
        # the theme-set hook do not quietly roll an explicit choice back -- a
        # shiny in particular would otherwise last only until the next apply.
        pins.write_today(args.date, name, choice.shiny)

    # The size is resolved before the early-out because the wallpaper's name
    # depends on it: a monitor change must read as "not current" and re-render.
    if args.size:
        width, height = (int(v) for v in args.size.lower().split("x"))
    else:
        width, height = screen_size()

    # Fetched before the early-out rather than with the wallpaper: the
    # creature's own colours are the palette's starting point, and in
    # "pokemon" mode the accent decides light-vs-dark, which the early-out
    # itself compares against. Cached, so a second run costs nothing.
    accent_source = None if args.type_hue else artwork.accent(dex_id,
                                                              choice.shiny)

    # Resolved every run rather than cached: with mode = "auto" the same
    # invocation gives different answers at 07:59 and 08:01, which is exactly
    # how the flip timer turns into a retint.
    mode = resolve_mode(configured=args.mode,
                        accent_source=accent_source
                        or type_colors[kinds[0]])
    intensity = config.intensity()
    variant = variant_slug(choice.shiny, mode, intensity)

    # The name is part of the check, not just the date: editing `pokemon` in the
    # config by hand should take effect on the next run rather than waiting for
    # tomorrow or needing --force. The mode is part of it for the same reason --
    # the flip timer's run must read as "not current".
    # `os.path.exists` guards a state file that outlived its wallpaper.
    if not args.force and state.matches(args.date, name, choice.shiny, mode) \
            and (args.no_wallpaper
                 or os.path.exists(background_path(dex_id, variant,
                                                   width, height))):
        print("%s already current: %s (%s); nothing to do"
              % (args.date, name, mode))
        return

    colors = palette.build(type_colors, kinds, accent_source,
                           mode=mode, intensity=intensity)
    header = "# Generated by omarchy-pokemon-theme -- do not edit by hand.\n" \
             "# %s: #%d %s%s (%s), accent from %s, %s%s\n" \
             % (args.date, dex_id, name, " shiny" if choice.shiny else "",
                "/".join(kinds), "artwork" if accent_source else "type",
                mode,
                "" if intensity == 1.0 else ", intensity %.2g" % intensity)

    # The wallpaper takes a couple of seconds to composite, and until every file
    # agrees the desktop is a mix of two themes. So the slow work happens before
    # anything the desktop reads is touched, and the files land together.
    if not args.no_wallpaper:
        wallpaper_for(dex_id, choice.shiny, colors, width, height,
                      mode=mode, variant=variant)

    atomic.text(os.path.join(ROOT, "colors.toml"),
                palette.to_toml(colors, header, mode))
    atomic.text(os.path.join(ROOT, "icons.theme"),
                icon_theme(colors["accent"]) + "\n")

    # Vesktop/Vencord retint. Written straight into the client's themes
    # directory rather than into the theme: omarchy-theme-set knows nothing
    # about Discord, and Vencord hot-reloads a changed theme file on its own.
    # No client installed means no files, and nothing to clean up later.
    for path in vesktop.targets():
        atomic.text(path, vesktop.css(colors, header, mode))

    # Pin omarchy-lock-pokemon to the same Pokemon, so unlocking shows the one
    # already on the desktop. A user who prefers a random lock sets
    # `pokemon-name = ""` under [lock] in ~/.config/omarchy/shell.toml, which
    # wins per-key over anything a theme ships.
    # The ambient section is written whether or not the plugin is installed: it
    # is inert without it, so installing the plugin later needs no regeneration.
    # Motion is on by default; --no-animation writes it switched off, and a user
    # can override per key with `effects = "hide"` under [background] in
    # ~/.config/omarchy/shell.toml.
    type_effects = load("type-effects.json")
    atomic.text(os.path.join(ROOT, "shell.background.toml"),
                ambient.section(type_effects, type_colors, kinds,
                                enabled=not args.no_animation, header=header,
                                is_shiny=choice.shiny))

    lock_path = os.path.join(ROOT, "shell.lock.toml")
    if args.no_lock_sync:
        if os.path.exists(lock_path):
            os.remove(lock_path)
    else:
        atomic.text(lock_path,
                    lockscreen.section(colors, name, header, choice.shiny))

    state.write(args.date, name, pins.SLUGS.get(source, "roll"), choice.shiny,
                mode)

    print("%s  #%d %s%s (%s)  accent %s  %s  [%s]"
          % (args.date, dex_id, name, " SHINY" if choice.shiny else "",
             "/".join(kinds), colors["accent"], mode, source))

    if not args.no_apply:
        apply_theme()


if __name__ == "__main__":
    main()

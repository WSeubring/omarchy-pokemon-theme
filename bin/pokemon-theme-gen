#!/usr/bin/env python3
"""Generate the Pokemon-of-the-day Omarchy theme.

Writes colors.toml and a single wallpaper into the theme directory, then asks
Omarchy to re-apply the theme so every downstream app retints.
"""

import argparse
import json
import os
import random
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import date

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))

import ambient  # noqa: E402
import artwork  # noqa: E402
import config  # noqa: E402
import lockscreen  # noqa: E402
import palette  # noqa: E402
import pins  # noqa: E402
import state  # noqa: E402
import wallpaper  # noqa: E402
import xdg  # noqa: E402
from oklch import hex_to_oklch  # noqa: E402

SLUG = "pokemon"
ARTWORK_URL = ("https://raw.githubusercontent.com/PokeAPI/sprites/master"
               "/sprites/pokemon/other/official-artwork/%d.png")
# Artwork lives outside the theme directory on purpose: `omarchy-theme-set`
# copies the whole theme into a staging dir on every apply, and a growing cache
# would be copied along with it.
CACHE = xdg.cache("artwork")

# One file only: omarchy's background chooser cycles the sorted list, so a
# single entry is the only way to guarantee today's wallpaper is the one picked.
BACKGROUND = os.path.join(ROOT, "backgrounds", "today.jpg")

# Yaru ships a fixed set of accent hues; pick whichever sits closest to the
# day's hue so the icon theme moves with the palette instead of staying put.
YARU_HUES = {
    "Yaru-red": 25.0,
    "Yaru-wartybrown": 50.0,
    "Yaru-yellow": 85.0,
    "Yaru-olive": 112.0,
    "Yaru-sage": 145.0,
    "Yaru-prussiangreen": 195.0,
    "Yaru-blue": 258.0,
    "Yaru-purple": 300.0,
    "Yaru-magenta": 340.0,
}


def ambient_plugin_installed():
    """True if an ambient background plugin is present.

    The plugin's presence *is* the on/off switch, so there is no separate config
    file to keep in sync: installing it enables the motion, removing it disables
    it, and a user who wants the plugin but no motion sets
    `effects = "hide"` under [background] in ~/.config/omarchy/shell.toml.
    """
    plugins = os.path.expanduser("~/.config/omarchy/plugins")
    try:
        entries = os.listdir(plugins)
    except OSError:
        return False
    return any(
        name.endswith(".background")
        and os.path.isfile(os.path.join(plugins, name, "manifest.json"))
        for name in entries
    )


def icon_theme(accent):
    hue = hex_to_oklch(accent)[2]
    return min(YARU_HUES,
               key=lambda name: abs(((YARU_HUES[name] - hue + 180) % 360) - 180))


def load(name):
    with open(os.path.join(ROOT, "data", name)) as fh:
        return json.load(fh)


def artwork_for(dex_id):
    """Return a cached artwork path, or None if it cannot be had."""
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, "%d.png" % dex_id)
    if os.path.exists(path) and os.path.getsize(path) > 0:
        return path
    try:
        with urllib.request.urlopen(ARTWORK_URL % dex_id, timeout=20) as resp:
            data = resp.read()
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        print("artwork unavailable (%s); rendering ground only" % exc,
              file=sys.stderr)
        return None
    tmp = path + ".part"
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.replace(tmp, path)
    return path


def screen_size(fallback=(2560, 1600)):
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], check=True,
                             capture_output=True, text=True).stdout
        mons = json.loads(out)
    except (OSError, subprocess.CalledProcessError, ValueError):
        return fallback
    if not mons:
        return fallback
    # Render for the largest attached monitor; PreserveAspectCrop handles the
    # rest, and upscaling a small render onto a big screen would show.
    best = max(mons, key=lambda m: m.get("width", 0) * m.get("height", 0))
    return int(best["width"]), int(best["height"])


def apply_theme():
    """Re-apply the theme so omarchy regenerates every dependent config.

    OMARCHY_POKEMON_APPLYING lets the theme-set hook see that this run is our
    own and bail out, instead of recursing.
    """
    env = dict(os.environ, OMARCHY_POKEMON_APPLYING="1")
    try:
        subprocess.run(["omarchy-theme-set", SLUG], check=True, env=env,
                       capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        print("omarchy-theme-set not on PATH; files written but not applied",
              file=sys.stderr)
        return False
    except subprocess.CalledProcessError as exc:
        print("omarchy-theme-set failed: %s" % (exc.stderr or "").strip(),
              file=sys.stderr)
        return False
    except subprocess.TimeoutExpired:
        print("omarchy-theme-set timed out", file=sys.stderr)
        return False
    return True


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--date", default=date.today().isoformat(),
                    help="YYYY-MM-DD to generate for (default: today)")
    ap.add_argument("--pokemon", metavar="NAME",
                    help="use this Pokemon for today; reverts at midnight")
    ap.add_argument("--random", action="store_true",
                    help="use a random Pokemon for today; reverts at midnight")
    ap.add_argument("--pin", metavar="NAME",
                    help="pin this Pokemon permanently, in the user config")
    ap.add_argument("--unpin", action="store_true",
                    help="drop both pins and go back to the daily roll")
    ap.add_argument("--no-apply", action="store_true",
                    help="write the files but do not re-apply the theme")
    ap.add_argument("--no-wallpaper", action="store_true",
                    help="only regenerate colors.toml")
    ap.add_argument("--size", help="wallpaper size as WxH")
    ap.add_argument("--no-animation", action="store_true",
                    help="write the background section with motion switched off")
    ap.add_argument("--no-lock-sync", action="store_true",
                    help="leave the lock screen to roll its own Pokemon")
    ap.add_argument("--type-hue", action="store_true",
                    help="take the accent from the type colour, not the artwork")
    ap.add_argument("--force", action="store_true",
                    help="regenerate even if today's theme is already written")
    args = ap.parse_args()

    dex, types = load("dex.json"), load("types.json")
    type_colors = load("type-colors.json")

    if args.pin and args.unpin:
        sys.exit("--pin and --unpin are mutually exclusive")
    if args.random and args.pokemon:
        sys.exit("--random and --pokemon are mutually exclusive")

    if args.pin:
        pinned = args.pin.lower()
        if pinned not in types:
            sys.exit("unknown pokemon: %s" % pinned)
        config.set_key("pokemon", pinned)
        # A today-only pin would otherwise keep winning over the new permanent
        # one for the rest of the day, which is not what "pin this" means.
        pins.clear_today()
        print("pinned %s in %s" % (pinned, config.PATH))
        args.force = True

    if args.unpin:
        removed = config.clear_key("pokemon")
        removed = pins.clear_today() or removed
        print("unpinned" if removed else "nothing was pinned")
        args.force = True

    requested = args.pokemon
    if args.random:
        # Excluding what is already showing matters more here than for the daily
        # roll: someone choosing "random" is asking to see something change, and
        # a 1-in-905 no-op reads as a broken button.
        requested = random.choice([n for n in dex if n != state.name()])

    try:
        dex_id, name, kinds, source = pins.resolve(args.date, dex, types,
                                                  requested)
    except ValueError as exc:
        sys.exit(str(exc))

    if requested:
        # Remembered for the rest of the day, so the timer, the boot catch-up and
        # the theme-set hook do not quietly roll an explicit choice back.
        pins.write_today(args.date, name)

    # The name is part of the check, not just the date: editing `pokemon` in the
    # config by hand should take effect on the next run rather than waiting for
    # tomorrow or needing --force.
    # `os.path.exists` guards a state file that outlived its wallpaper.
    if not args.force and state.matches(args.date, name) \
            and os.path.exists(BACKGROUND):
        print("%s already current: %s; nothing to do" % (args.date, name))
        return

    # Fetched before the palette rather than with the wallpaper: the creature's
    # own colours are the palette's starting point, so the download has to have
    # happened by now. It is cached, so a second run costs nothing.
    art = artwork_for(dex_id)
    accent_source = None
    if art and not args.type_hue:
        accent_source = artwork.cached(art, art.rsplit(".", 1)[0] + ".accent")

    colors = palette.build(type_colors, kinds, accent_source)
    header = "# Generated by omarchy-pokemon-theme -- do not edit by hand.\n" \
             "# %s: #%d %s (%s), accent from %s\n" \
             % (args.date, dex_id, name, "/".join(kinds),
                "artwork" if accent_source else "type")
    with open(os.path.join(ROOT, "colors.toml"), "w") as fh:
        fh.write(palette.to_toml(colors, header))

    with open(os.path.join(ROOT, "icons.theme"), "w") as fh:
        fh.write(icon_theme(colors["accent"]) + "\n")

    # Pin omarchy-lock-pokemon to the same Pokemon, so unlocking shows the one
    # already on the desktop. A user who prefers a random lock sets
    # `pokemon-name = ""` under [lock] in ~/.config/omarchy/shell.toml, which
    # wins per-key over anything a theme ships.
    # The ambient section is written whether or not the plugin is installed: it
    # is inert without it, so installing the plugin later needs no regeneration.
    type_effects = load("type-effects.json")
    animate = ambient_plugin_installed() and not args.no_animation
    with open(os.path.join(ROOT, "shell.background.toml"), "w") as fh:
        fh.write(ambient.section(type_effects, type_colors, kinds,
                                 enabled=animate, header=header))

    lock_path = os.path.join(ROOT, "shell.lock.toml")
    if args.no_lock_sync:
        if os.path.exists(lock_path):
            os.remove(lock_path)
    else:
        with open(lock_path, "w") as fh:
            fh.write(lockscreen.section(colors, name, header))

    if not args.no_wallpaper:
        if args.size:
            w, h = (int(v) for v in args.size.lower().split("x"))
        else:
            w, h = screen_size()
        os.makedirs(os.path.dirname(BACKGROUND), exist_ok=True)
        wallpaper.render(art, colors, BACKGROUND, w, h)

    state.write(args.date, name, pins.SLUGS.get(source, "roll"))

    print("%s  #%d %s (%s)  accent %s  [%s]"
          % (args.date, dex_id, name, "/".join(kinds), colors["accent"], source))

    if not args.no_apply:
        apply_theme()


if __name__ == "__main__":
    main()

#!/bin/bash
# Pick a Pokemon from the native omarchy menu.
#
# omarchy-menu-select renders a searchable list and reads its options from
# stdin, so all 905 go in and the menu's own fuzzy search is the autocomplete.
# That avoids writing 905 rows into the user's omarchy-menu.jsonc, and avoids
# needing a custom menu provider -- the provider table in the menu plugin is
# hard-coded in QML and cannot be extended from a config file.

set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
GEN="$REPO/bin/pokemon-theme-gen"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-pokemon-theme/current"

mode="today"
case "${1:-}" in
--pin) mode="pin" ;;
--random) mode="random" ;;
--hunt) mode="hunt" ;;
--today | "") mode="today" ;;
-h | --help)
  cat <<USAGE
Usage: pokemon-theme-pick [--today|--random|--hunt|--pin]

Opens the omarchy menu to pick a Pokemon.

  --today   use it until midnight (default)
  --random  skip the list, take a random one until midnight
  --hunt    one shiny roll against a random Pokemon; press it again
  --pin     pin it permanently in the user config
USAGE
  exit 0
  ;;
*)
  echo "unknown option: $1" >&2
  exit 1
  ;;
esac

# Reports the result, since a menu row that runs and says nothing looks broken.
# The generator prints "<date>  #N <name> (<types>)  accent <hex>  [<source>]".
announce() {
  local line="$1" name types title body
  name=$(sed -n 's/.*#[0-9]* \([a-z0-9-]*\).*/\1/p' <<<"$line")
  types=$(sed -n 's/.*(\([a-z/ ]*\)).*/\1/p' <<<"$line")
  [[ -n $name ]] || return 0
  title="${name^} — ${types:-?}"
  body="Theme updated"
  # A shiny is the whole reason the hunt row exists, so it does not get the same
  # notification as an ordinary reroll.
  if [[ $line == *SHINY* ]]; then
    title="✨ Shiny ${name^} — ${types:-?}"
    body="One in $(shiny_odds). Theme updated"
  fi
  omarchy-notification-send -t 4000 "$title" "$body" 2>/dev/null || true
}

# The odds the hunt just beat, straight from the same place the generator reads
# them, so a shortened `shiny-hunt-odds` is reported honestly.
shiny_odds() {
  python3 -c "import sys; sys.path.insert(0, '$REPO/lib'); import shiny; print(shiny.hunt_odds())" 2>/dev/null || echo "?"
}

# Neither --random nor --hunt needs the list, so neither needs the menu to be
# available at all.
if [[ $mode == random ]]; then
  announce "$("$GEN" --random | tail -1)"
  exit 0
fi

if [[ $mode == hunt ]]; then
  announce "$("$GEN" --hunt | tail -1)"
  exit 0
fi

command -v omarchy-menu-select >/dev/null ||
  { echo "omarchy-menu-select not found; needs Omarchy 4" >&2; exit 1; }

current=$(awk '{print $2}' "$STATE" 2>/dev/null || true)

if [[ $mode == pin ]]; then
  prompt="Pin a Pokemon"
else
  prompt="Pokemon for today"
fi

# "<glyph>\t<label>\t<subtext>": the glyph is displayed but never returned, so
# the active Pokemon can be ticked without changing what comes back. The
# selection returns "<label>\t<subtext>" once a subtext is present.
selection=$(
  jq -r --arg current "$current" '
    to_entries
    | sort_by(.key)
    | .[]
    | [(if .key == $current then "✓" else "" end), .key, (.value | join(" / "))]
    | @tsv
  ' "$REPO/data/types.json" | omarchy-menu-select "$prompt" -- --width 520
) || exit 0

name=$(printf '%s' "$selection" | cut -f1)
[[ -n $name ]] || exit 0

if [[ $mode == pin ]]; then
  announce "$("$GEN" --pin "$name" | tail -1)"
else
  announce "$("$GEN" --pokemon "$name" | tail -1)"
fi
